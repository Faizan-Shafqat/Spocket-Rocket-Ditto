# Sprocket Rocket preview portal (Brad API) — POST /api/sr-preview-publish
# Bearer token from Brad / preview.sprocketrocket.co Slack (do not commit).
SR_PREVIEW_PUBLISH_TOKEN=
# SR_PREVIEW_API_BASE=https://preview.sprocketrocket.co
# SR_PREVIEW_USE_KNOWN_GOOD=1  # publish to smuves-com/site-mpvb2qjx instead of per-site client/project slug
# Docs password (browser only): see team Slack — not used by Ditto server.

# Optional: overrides the default PAT in server.js for POST /install-theme → HubSpot spocket-installer.
HUBSPOT_INSTALLER_PAT=

# typography-extract service (runs separately, e.g. typography-extract-api/typography-extract on port 8787)
# TYPOGRAPHY_EXTRACT_BASE_URL=http://127.0.0.1:8787
# Or set full POST URL explicitly:
# TYPOGRAPHY_EXTRACT_API_URL=http://127.0.0.1:8787/api/typography
# Ditto POST /api/typography-extract-ai: set to 1 to also call the typography-extract service when the body omits playwright_extract (opt-in; default is HTML+OpenAI only).
# DITTO_SERVER_PLAYWRIGHT_ON_PURPLE=1

# OpenAI — required for POST /api/hero-match (AI HTML typography + SR Hero 01 decision)
# and POST /api/typography-extract-ai (AI-only typography extract + optional hero + SR compare).
# Optional body flag include_integrated_assessment=true adds a final OpenAI json pass that merges
# typography_ai, hero_ai, and sr_hero_01.decision into integrated_theme_assessment (extra latency/cost).
# Default model for Ditto OpenAI routes (typography, hero, SR fit, theme-inject-plan).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# POST /api/typography-extract-url and POST /api/sr-decision-lightrag use
# `tools: [{ "type": "web_search" }]` on the Responses API (extra cost per search).
# OpenAI does not allow web_search + json_object mode together — Ditto omits json_object
# when web_search is on and parses JSON from the model text instead.
# typography-extract-url is AI-only; Playwright is POST /api/typography-extract (separate button).
# sr-decision-lightrag requires BOTH Playwright JSON + typography-extract-url JSON in the body.
# Set to 0/false to disable web search on those routes only.
OPENAI_ENABLE_WEB_SEARCH=1

# Outbound wait for OpenAI HTTP (typography-extract-url with web_search can take 1–3+ min).
# Default when unset: 600000 (10 min) with web_search, 300000 otherwise. 0 = no AbortController.
# OPENAI_REQUEST_TIMEOUT_MS=900000

# GPT-5 family uses POST /v1/responses (Ditto routes when the model id starts with `gpt-5`).
# Override URL or force behavior:
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# OPENAI_JSON_CHAT_USE_RESPONSES=1
# OPENAI_MAX_OUTPUT_TOKENS=8192
#
# Per-route output caps for POST /v1/responses (each clamped to OPENAI_MAX_OUTPUT_TOKENS, min 256).
# Smaller = faster / cheaper JSON for Ditto typography-extract-ai, hero-match, theme-inject-plan.
# OPENAI_RESPONSES_MAX_OUT_TYPOGRAPHY=2048
# OPENAI_RESPONSES_MAX_OUT_HERO=2048
# OPENAI_RESPONSES_MAX_OUT_INTEGRATED=3072
# OPENAI_RESPONSES_MAX_OUT_SR_FIT=3072
# OPENAI_RESPONSES_MAX_OUT_THEME_PLAN=4096
#
# GPT-5.x on Responses API — lower latency (omit a key by setting to `off` where noted).
# OPENAI_RESPONSES_REASONING_EFFORT=low
# OPENAI_RESPONSES_TEXT_VERBOSITY=low
# Enterprise: OPENAI_RESPONSES_SERVICE_TIER=priority
#
# Ditto does not yet consume streamed Responses bodies for JSON — leave streaming off.
# OPENAI_RESPONSES_STREAM=0

# How long Ditto waits when downloading a live site's HTML (AI typography + hero-match). Milliseconds, 5000–180000.
# DITTO_HTML_FETCH_TIMEOUT_MS=90000

# Max characters of HTML kept after fetch (AI typography / hero / hero-match). Clamped 50000–500000. Default 200000.
# DITTO_HTML_FETCH_MAX_CHARS=200000

# Max bytes of graph_chunk_entity_relation.graphml read from disk for theme-inject (20000–900000). Default 280000.
# DITTO_GRAPHML_PROMPT_MAX_BYTES=280000

# Max bytes of that graph excerpt actually sent **inside the OpenAI prompt** for theme-inject-plan (4000–250000).
# Keeps vector hits + cheatsheets from being cut off by huge graph text. Default 56000.
# DITTO_THEME_INJECT_GRAPHML_PROMPT_MAX_BYTES=56000

# Inbound HTTP socket idle timeout for the Express server (ms). 0 = disabled (recommended for
# GPT-5.5 Pro /responses calls that can sit many minutes with no bytes to the browser — otherwise
# Chrome shows "Failed to fetch"). Set e.g. 600000 (10 min) if you prefer a hard cap.
# DITTO_HTTP_INBOUND_TIMEOUT_MS=0

# Embeddings model used by `npm run ingest:lightrag` (writes cache/lightrag/.naive_data/vdb_chunks.json).
# Defaults to text-embedding-3-large (3072-dim). text-embedding-3-small is faster/cheaper.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Real LightRAG (HKUDS) server URL — used by /api/hero-match when alive.
# Start it with `npm run lightrag:server` (config in .env.lightrag).
# LIGHTRAG_SERVER_URL=http://127.0.0.1:9621
# LIGHTRAG_API_KEY=
